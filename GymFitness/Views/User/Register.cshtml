@model GymFitness.ViewModel.RegisterViewModel

@{
    ViewData["Title"] = "Register";
}

<link rel="stylesheet" href="~/css/auth-rauth.css" asp-append-version="true" />

<link rel="stylesheet"
href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="auth-container">
    <!-- LEFT SIDE -->
    <div class="left-panel">
        <div class="overlay">
            <div class="brand">
                <i class="bi bi-heart-pulse-fill"></i>
                <h1>FITTRACKER</h1>
            </div>

            <h2>
                Push Yourself
                Beyond Your Limits
            </h2>

            <p>
                Track workouts, monitor calories,
                achieve your goals and transform
                yourself every single day.
            </p>

            <ul>
                <li>
                    <i class="bi bi-check-circle-fill"></i>
                    Workout Tracking
                </li>
                <li>
                    <i class="bi bi-check-circle-fill"></i>
                    Calories Monitoring
                </li>
                <li>
                    <i class="bi bi-check-circle-fill"></i>
                    Daily Progress Reports
                </li>
                <li>
                    <i class="bi bi-check-circle-fill"></i>
                    Fitness Analytics
                </li>
            </ul>
        </div>
    </div>
    <!-- RIGHT SIDE -->
    <div class="right-panel">
        <div class="glass-card">
            <h2>Create Account</h2>
            <p class="subtitle">
                Join thousands of fitness enthusiasts
            </p>

            <form asp-action="Register" method="post">
                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Name"></label>
                        <div class="input-box">
                            <i class="bi bi-person"></i>
                            <input asp-for="Name"
                                   class="form-control"
                                   placeholder="Full Name">
                        </div>
                        <span asp-validation-for="Name"
                              class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Email"></label>
                        <div class="input-box">
                            <i class="bi bi-envelope"></i>
                            <input asp-for="Email"
                                   class="form-control"
                                   placeholder="Email Address">
                        </div>
                        <span asp-validation-for="Email"
                              class="text-danger"></span>
                    </div>
                </div>
    </form>
@{
    ViewData["Title"] = "Register";
}
